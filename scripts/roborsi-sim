#!/usr/bin/env bash
# Launcher for running roborsi inside the RoboTwin conda env.
#
# Use whenever a skill needs SAPIEN / cuRobo / pytorch3d (any sim/data
# collection / training / eval against RoboTwin). The robo-rsi .venv does
# NOT have those — RoboTwin lives in its own conda env.
#
# Usage:
#   ./scripts/roborsi-sim <args for roborsi CLI>
#
# Examples:
#   roborsi-sim sim list
#   roborsi-sim task run beat_block_hammer --only collect_expert
#   roborsi-sim farm run expert_replay --workers 2 --params '{"task":"beat_block_hammer"}'

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
ROBORSI_ROOT="${ROBORSI_ROOT:-$(cd "$SCRIPT_DIR/.." && pwd)}"
ROBOTWIN_ROOT="${ROBORSI_ROBOTWIN_ROOT:-$HOME/RoboTwin}"
CONDA_BASE="${CONDA_BASE:-$HOME/miniconda3}"
CONDA_ENV="${ROBORSI_CONDA_ENV:-RoboTwin}"
CUDA_PREFIX="${CUDA_PREFIX:-/usr/local/cuda-11.8}"

# Bypass any other venv (.venv etc) by pinning the env's python directly.
ENV_PREFIX="$CONDA_BASE/envs/$CONDA_ENV"
PYTHON="$ENV_PREFIX/bin/python"
if [ ! -x "$PYTHON" ]; then
  echo "[roborsi-sim] $PYTHON not found — RoboTwin env missing" >&2
  exit 1
fi

export CUDA_HOME="$CUDA_PREFIX"
export PATH="$CUDA_PREFIX/bin:$ENV_PREFIX/bin:$PATH"
export LD_LIBRARY_PATH="$ENV_PREFIX/lib:$CUDA_PREFIX/extras/CUPTI/lib64:$CUDA_PREFIX/lib64:${LD_LIBRARY_PATH:-}"
export PYTHONPATH="$ROBORSI_ROOT:${PYTHONPATH:-}"
export ROBORSI_ROBOTWIN_ROOT="$ROBOTWIN_ROOT"
# Enable real GraspNet-baseline inference for get_grasp_pose (auto top-down
# fallback if ckpt missing).
export GRASPNET_CKPT="${GRASPNET_CKPT:-$HOME/.roborsi/models/graspnet/checkpoint-rs.tar}"
export GRASPNET_REPO="${GRASPNET_REPO:-$HOME/graspnet-baseline}"
unset PYTHONHOME

# RoboTwin's task_config files use relative './assets' — must run from its root
cd "$ROBOTWIN_ROOT"

exec "$PYTHON" -m roborsi.sim_cli "$@"
