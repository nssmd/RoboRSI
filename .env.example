# Provider credentials. Set only the provider you use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional local checkouts for simulation.
ROBORSI_ROBOTWIN_ROOT=
ROBORSI_BICOORD_ROOT=

# Optional runtime locations.
ROBORSI_HOME=
ROBORSI_LOG_DIR=
ROBORSI_ARTIFACT_DIR=

# Runtime behavior: evolve (default) or eval (frozen capability set).
ROBORSI_RUN_MODE=evolve

# Optional model selection.
ROBORSI_VLM_MODEL=
ROBORSI_PERCEPTION_MODEL=

# Use "responses" for Responses-only OpenAI-compatible gateways.
ROBORSI_OPENAI_TRANSPORT=chat_completions
